# Copy to .env.local and fill in values.

# MongoDB connection string (Atlas M0 free tier or local mongod)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/resume-builder?retryWrites=true&w=majority

# NextAuth / Auth.js
# Generate with: openssl rand -base64 32   (or https://generate-secret.vercel.app/32)
AUTH_SECRET=replace-with-32-byte-random-secret

# Deployment URL (Vercel sets this automatically in production)
AUTH_URL=http://localhost:3000

# Trust the platform-provided host header (required on Vercel so redirects
# work across *.vercel.app domains). Set to "true" in production.
AUTH_TRUST_HOST=false
